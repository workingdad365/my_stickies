<Window x:Class="MyStickies.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MyStickies.Controls"
        xmlns:layout="clr-namespace:MyStickies.Layout"
        Title="MyStickies"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource NoteFont}"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        PreviewMouseMove="Window_PreviewMouseMove" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        Deactivated="Window_Deactivated">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="메모 관리" Click="AllNotes_Click"/>
            <MenuItem Header="설정" Click="Settings_Click"/>
            <MenuItem x:Name="ToggleVisibilityItem" Header="감추기" Click="ToggleVisibility_Click"/>
            <Separator/>
            <MenuItem Header="종료" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root">

        <!-- 휴면 상태: 우측 가장자리의 얇은 책갈피. 노트 색상 점만 표시 -->
        <Grid x:Name="Bookmark"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="22">
            <Grid.Resources>
                <Style x:Key="BookmarkControlStyle" TargetType="Control">
                    <Setter Property="Height" Value="{x:Static layout:DeckGeometry.BookmarkControlHeight}"/>
                    <Setter Property="Background" Value="#993A3A48"/>
                    <Setter Property="Foreground" Value="#EEEEF2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4,0,0,4">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#DD525260"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding DeckNotes.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Thumb x:Name="BookmarkHandle" Grid.Row="0" Style="{StaticResource BookmarkControlStyle}"
                   Tag="&#xE784;" Cursor="SizeNS" Focusable="False"
                   ToolTip="북마크 위치 이동" AutomationProperties.Name="북마크 위치 이동"
                   DragStarted="BookmarkHandle_DragStarted" DragDelta="BookmarkHandle_DragDelta"
                   DragCompleted="BookmarkHandle_DragCompleted"/>
            <Border x:Name="BookmarkBody" Grid.Row="1" Padding="6,8"
                    CornerRadius="11,0,0,11" Background="#993A3A48"
                    MouseEnter="BookmarkBody_MouseEnter">
            <Grid IsHitTestVisible="False">
                <ItemsControl ItemsSource="{Binding DeckNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="10" Height="30" Margin="0,3"
                                    CornerRadius="5"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 메모가 한 장도 없을 때: 빈 점 하나로 책갈피 위치를 알림 -->
                <Border Width="10" Height="10" Margin="0,3" CornerRadius="5" Background="#88FFFFFF"
                        VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeckNotes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            </Border>
            <Button Grid.Row="2" Style="{StaticResource BookmarkControlStyle}"
                    Tag="&#xE921;" Cursor="Hand" Focusable="False"
                    ToolTip="감추기" AutomationProperties.Name="북마크 감추기"
                    Click="HideBookmark_Click"/>
        </Grid>

        <!-- 팬아웃 중 카드와 + 버튼 사이 빈 공간에서도 마우스가 창 안에 머물도록 하는 투명 호버 영역.
             알파 1의 배경은 눈에 보이지 않지만 히트 테스트 대상이 되어 MouseLeave가 발생하지 않음 -->
        <Border x:Name="HoverZone"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="88" Background="#01000000"
                IsHitTestVisible="False"/>

        <!-- 팬아웃/확장 상태: 노트 카드 덱 -->
        <StackPanel x:Name="Deck"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    SizeChanged="Deck_SizeChanged">
            <ItemsControl x:Name="TabList" ItemsSource="{Binding DeckNotes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctl:NoteTab MouseEnter="Tab_MouseEnter" MouseLeave="Tab_MouseLeave"
                                     PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                     EditStarted="Tab_EditStarted" EditEnded="Tab_EditEnded"
                                     DeleteRequested="Tab_DeleteRequested"
                                     ArchiveRequested="Tab_ArchiveRequested"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 새 메모 추가 버튼. 마지막 카드 바로 아래에 붙어 카드가 확장되면 함께 밀려 내려감.
                 위가 밝고 아래가 어두운 그라데이션과 테두리, 그림자로 입체감을 줌 -->
            <Border x:Name="PlusButton"
                    Width="30" Height="30" Margin="0,4,12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    CornerRadius="15" BorderThickness="1"
                    Cursor="Hand"
                    MouseLeftButtonUp="PlusButton_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#8C8C9A"/>
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#EDEDF1" Offset="0.5"/>
                                    <GradientStop Color="#CFCFD8" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#6E6E7C"/>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="#F6F6F9" Offset="0.5"/>
                                            <GradientStop Color="#DCDCE4" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="3" Direction="270" Opacity="0.45"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PlusTranslate" X="80"/>
                </Border.RenderTransform>
                <!-- 안쪽 위 가장자리 하이라이트로 볼록한 느낌 -->
                <Border CornerRadius="14" BorderThickness="1,1,1,0" BorderBrush="#B0FFFFFF">
                    <TextBlock Text="+" FontSize="19" FontWeight="SemiBold" Foreground="#3A3A48"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-3,0,0"/>
                </Border>
            </Border>
        </StackPanel>
    </Grid>
</Window>

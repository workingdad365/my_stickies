<Window x:Class="MyStickies.Windows.AllNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyStickies.Localization"
        xmlns:conv="clr-namespace:MyStickies.Converters"
        Title="{loc:Text ManageNotes}"
        Width="960" Height="620" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/MyStickies;component/Assets/app.ico"
        Background="#F7F6F2"
        FontFamily="{DynamicResource NoteFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:RelativeTimeConverter x:Key="RelativeTime"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A85"/>

        <!-- 필터 칩 버튼 -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="12,5" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E7E1"/>
                                <Setter Property="Foreground" Value="#23232B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 상세 카드 편집용 텍스트 상자. 읽기용 TextBlock과 같은 자리에 겹쳐 두고 전환 -->
        <Style x:Key="DetailEditBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="-2,0,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="FontFamily" Value="{DynamicResource NoteFont}"/>
            <Setter Property="CaretBrush" Value="{StaticResource NoteTitleBrush}"/>
        </Style>

        <!-- 연한 회색 버튼 -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#23232B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="14,7" Background="#E9E7E1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DEDBD3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 목록 항목: 색상 바, 제목, 미리보기, 상태 글자, 상대 시각 -->
        <DataTemplate x:Key="NoteItem">
            <Grid Margin="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="4" CornerRadius="2" Margin="0,2,12,2"
                        Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#23232B" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{loc:Text Active}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                    <Setter Property="Text" Value="{loc:Text Hidden}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Text="{loc:Text RelativeTime, Value={Binding UpdatedAt}, Relative=True}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="NoteListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EFEDE8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6E3DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="320"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 검색, 필터, 목록 -->
        <Grid Grid.Column="0" Margin="24,24,12,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Text ManageNotes}" FontSize="20" FontWeight="SemiBold" Foreground="#23232B"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="-6,8,0,0">
                    <Button Content="{loc:Text ImportButton}" Style="{StaticResource SoftButton}" Click="Import_Click"/>
                    <Button Content="{loc:Text ExportAllButton}" Style="{StaticResource SoftButton}" Click="ExportAll_Click"/>
                    <Button Content="{loc:Text NewNote}" Style="{StaticResource SoftButton}" Click="NewNote_Click"/>
                </StackPanel>
            </Grid>

            <!-- 검색 상자 -->
            <Border Grid.Row="1" CornerRadius="10" Background="#ECEAE4" Padding="12,8" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0"
                             FontSize="13" Foreground="#23232B" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="{loc:Text SearchNotes}" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>

            <!-- 필터 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="{loc:Text All}" Tag="all" IsChecked="True" Style="{StaticResource FilterChip}" Checked="Filter_Checked"/>
                <RadioButton Content="{loc:Text Active}" Tag="active" Style="{StaticResource FilterChip}" Checked="Filter_Checked"/>
                <RadioButton Content="{loc:Text Hidden}" Tag="archived" Style="{StaticResource FilterChip}" Checked="Filter_Checked"/>
            </StackPanel>

            <ListBox x:Name="NoteList" Grid.Row="3"
                     Background="Transparent" BorderThickness="0"
                     ItemTemplate="{StaticResource NoteItem}"
                     ItemContainerStyle="{StaticResource NoteListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>

        <!-- 오른쪽: 선택한 노트 상세 -->
        <Border Grid.Column="1" Background="#F1EFEA" Padding="24">
            <Grid>
                <TextBlock Text="{loc:Text ChooseNote}" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=NoteList}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid DataContext="{Binding SelectedItem, ElementName=NoteList}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 상태와 동작 버튼 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                                     Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{loc:Text ActiveDeck}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                <Setter Property="Text" Value="{loc:Text HiddenState}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="{loc:Text Hide}" Style="{StaticResource SoftButton}" Click="Archive_Click">
                                <Button.Visibility>
                                    <Binding Path="IsArchived">
                                        <Binding.Converter>
                                            <conv:BoolToVisibilityConverter Invert="True"/>
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                            <Button Content="{loc:Text Restore}" Style="{StaticResource SoftButton}" Click="Restore_Click">
                                <Button.Visibility>
                                    <Binding Path="IsArchived">
                                        <Binding.Converter>
                                            <conv:BoolToVisibilityConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                            <Button Content="{loc:Text ExportButton}" Style="{StaticResource SoftButton}" Click="Export_Click"/>
                            <Button Content="{loc:Text Delete}" Style="{StaticResource SoftButton}" Foreground="#B3261E" Click="Delete_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 노트 카드 -->
                    <Border Grid.Row="1" CornerRadius="16" Padding="24"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 제목: 클릭하면 편집. 읽기용과 편집용을 겹쳐 두고 전환 -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid Margin="0,0,120,0">
                                    <TextBlock x:Name="DetailTitle" Text="{Binding Title}" FontSize="{DynamicResource DetailTitleSize}" FontWeight="SemiBold"
                                               Foreground="{StaticResource NoteTitleBrush}" TextTrimming="CharacterEllipsis"
                                               Cursor="IBeam" ToolTip="{loc:Text EditTooltip}"
                                               MouseLeftButtonUp="DetailTitle_MouseLeftButtonUp"/>
                                    <TextBox x:Name="DetailTitleBox" Style="{StaticResource DetailEditBox}"
                                             FontSize="{DynamicResource DetailTitleSize}" FontWeight="SemiBold"
                                             Foreground="{StaticResource NoteTitleBrush}"
                                             KeyDown="DetailTitleBox_KeyDown"/>
                                </Grid>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource NoteLabelBrush}"
                                           Text="{loc:Text UpdatedDate, Value={Binding UpdatedAt}}"/>
                            </Grid>

                            <!-- 본문: 빈 영역을 눌러도 편집에 들어가도록 투명 배경으로 히트 테스트 -->
                            <Grid Grid.Row="1" Background="Transparent" MouseLeftButtonUp="DetailBody_MouseLeftButtonUp">
                                <ScrollViewer x:Name="DetailBodyScroll" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="DetailBody" Text="{Binding Body}" FontSize="{DynamicResource DetailBodySize}" LineHeight="{DynamicResource DetailBodyLineHeight}"
                                               Foreground="{StaticResource NoteBodyBrush}" TextWrapping="Wrap"
                                               Cursor="IBeam" ToolTip="{loc:Text EditTooltip}"/>
                                </ScrollViewer>
                                <TextBox x:Name="DetailBodyBox" Style="{StaticResource DetailEditBox}"
                                         FontSize="{DynamicResource DetailBodySize}"
                                         Foreground="{StaticResource NoteBodyBrush}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         KeyDown="DetailBodyBox_KeyDown"/>
                            </Grid>

                            <!-- 하단: 색상 선택 점, 생성/수정 시각, 편집 중에는 저장/취소 -->
                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#33000000" Margin="0,16,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <StackPanel x:Name="DetailColorRow" Orientation="Horizontal" VerticalAlignment="Center"
                                                ToolTip="{loc:Text NoteColor}"/>

                                    <TextBlock x:Name="DetailTimes" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource NoteLabelBrush}">
                                        <Run Text="{loc:Text CreatedDate, Value={Binding CreatedAt}}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{loc:Text UpdatedRelative, Value={Binding UpdatedAt}, Relative=True}"/>
                                    </TextBlock>

                                    <StackPanel x:Name="DetailEditActions" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{loc:Text EditShortcuts}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource NoteLabelBrush}" Margin="0,0,6,0"/>
                                        <Button Content="{loc:Text Cancel}" Style="{StaticResource SoftButton}" Click="DetailCancel_Click"/>
                                        <Button Content="{loc:Text Save}" Style="{StaticResource SoftButton}" FontWeight="SemiBold" Click="DetailSave_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

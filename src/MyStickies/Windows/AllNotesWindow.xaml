<Window x:Class="MyStickies.Windows.AllNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MyStickies.Converters"
        Title="My Stickies - 메모 관리"
        Width="960" Height="620" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="#F7F6F2"
        FontFamily="{DynamicResource NoteFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:RelativeTimeConverter x:Key="RelativeTime"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A85"/>

        <!-- 필터 알약 버튼 -->
        <Style x:Key="FilterPill" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="12,5" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9E7E1"/>
                                <Setter Property="Foreground" Value="#23232B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 연한 회색 버튼 -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#23232B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="14,7" Background="#E9E7E1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DEDBD3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 목록 항목: 색상 바, 제목, 미리보기, 상태 글자, 상대 시각 -->
        <DataTemplate x:Key="NoteItem">
            <Grid Margin="4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="4" CornerRadius="2" Margin="0,2,12,2"
                        Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#23232B" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="활성"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                    <Setter Property="Text" Value="숨김"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="NoteListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EFEDE8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E6E3DC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="320"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 검색, 필터, 목록 -->
        <Grid Grid.Column="0" Margin="24,24,12,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="메모 관리" FontSize="20" FontWeight="SemiBold" Foreground="#23232B"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="가져오기..." Style="{StaticResource SoftButton}" Click="Import_Click"/>
                    <Button Content="전체 내보내기..." Style="{StaticResource SoftButton}" Click="ExportAll_Click"/>
                    <Button Content="새 메모" Style="{StaticResource SoftButton}" Click="NewNote_Click"/>
                </StackPanel>
            </Grid>

            <!-- 검색 상자 -->
            <Border Grid.Row="1" CornerRadius="10" Background="#ECEAE4" Padding="12,8" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0"
                             FontSize="13" Foreground="#23232B" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="메모 검색" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="12"
                               Foreground="{StaticResource MutedBrush}"/>
                </Grid>
            </Border>

            <!-- 필터 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="전체" Tag="all" IsChecked="True" Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                <RadioButton Content="활성" Tag="active" Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
                <RadioButton Content="숨김" Tag="archived" Style="{StaticResource FilterPill}" Checked="Filter_Checked"/>
            </StackPanel>

            <ListBox x:Name="NoteList" Grid.Row="3"
                     Background="Transparent" BorderThickness="0"
                     ItemTemplate="{StaticResource NoteItem}"
                     ItemContainerStyle="{StaticResource NoteListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>

        <!-- 오른쪽: 선택한 노트 상세 -->
        <Border Grid.Column="1" Background="#F1EFEA" Padding="24">
            <Grid>
                <TextBlock Text="왼쪽에서 메모를 선택하세요" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=NoteList}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid DataContext="{Binding SelectedItem, ElementName=NoteList}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 상태와 동작 버튼 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,10,0"
                                     Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="활성 · 덱에 표시"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                <Setter Property="Text" Value="숨김 상태"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="숨김" Style="{StaticResource SoftButton}" Click="Archive_Click">
                                <Button.Visibility>
                                    <Binding Path="IsArchived">
                                        <Binding.Converter>
                                            <conv:BoolToVisibilityConverter Invert="True"/>
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                            <Button Content="복원" Style="{StaticResource SoftButton}" Click="Restore_Click">
                                <Button.Visibility>
                                    <Binding Path="IsArchived">
                                        <Binding.Converter>
                                            <conv:BoolToVisibilityConverter/>
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                            </Button>
                            <Button Content="내보내기..." Style="{StaticResource SoftButton}" Click="Export_Click"/>
                            <Button Content="삭제" Style="{StaticResource SoftButton}" Foreground="#B3261E" Click="Delete_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 노트 카드 -->
                    <Border Grid.Row="1" CornerRadius="16" Padding="24"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource DetailTitleSize}" FontWeight="SemiBold"
                                           Foreground="{StaticResource NoteTitleBrush}" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,120,0"/>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource NoteLabelBrush}"
                                           Text="{Binding UpdatedAt, StringFormat='수정 {0:MM.dd HH:mm}'}"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding Body}" FontSize="{DynamicResource DetailBodySize}" LineHeight="{DynamicResource DetailBodyLineHeight}"
                                           Foreground="{StaticResource NoteBodyBrush}" TextWrapping="Wrap"/>
                            </ScrollViewer>

                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#33000000" Margin="0,16,0,0" Padding="0,10,0,0">
                                <TextBlock FontSize="12" Foreground="{StaticResource NoteLabelBrush}">
                                    <Run Text="{Binding CreatedAt, StringFormat='생성 {0:yyyy-MM-dd HH:mm}', Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}, StringFormat='수정 {0}', Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

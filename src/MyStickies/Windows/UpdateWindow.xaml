<Window x:Class="MyStickies.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Stickies 업데이트"
        Width="500" Height="440" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="#F7F6F2"
        FontFamily="{DynamicResource NoteFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7A85"/>

        <!-- 연한 회색 버튼 -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#23232B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="14,7" Background="#E9E7E1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DEDBD3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 진한 강조 버튼 -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="16,7" Background="#3A3A48">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#23232B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Headline" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="#23232B"/>
        <TextBlock x:Name="SubText" Grid.Row="1" FontSize="12" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,12"/>

        <!-- 릴리스 노트 -->
        <Border Grid.Row="2" CornerRadius="10" Background="#ECEAE4" Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Notes" FontSize="13" Foreground="#23232B" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- 다운로드 진행 -->
        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Margin="0,6,0,0"
                         BorderThickness="0" Background="#DEDBD3" Foreground="#3A3A48"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="이 버전 건너뛰기" Style="{StaticResource SoftButton}"
                    HorizontalAlignment="Left" Margin="0" Click="Skip_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Content="나중에" Style="{StaticResource SoftButton}" Click="Later_Click"/>
                <Button x:Name="InstallButton" Content="지금 설치" Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

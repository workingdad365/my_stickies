<Window x:Class="MyStickies.Windows.FloatingNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyStickies.Localization"
        xmlns:ctl="clr-namespace:MyStickies.Controls"
        Title="{loc:Text PinnedTitle, Value={Binding Title}}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Border Padding="8">
        <ctl:NoteTab x:Name="NoteView"/>
    </Border>
</Window>

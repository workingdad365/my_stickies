<Window x:Class="MyStickies.Windows.DataLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MyStickies.Localization"
        Title="{loc:Text Settings}"
        Width="560" SizeToContent="Height"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/MyStickies;component/Assets/app.ico"
        Background="#F7F6F2"
        FontFamily="Malgun Gothic"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#23232B"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="14,7" Background="#E9E7E1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DEDBD3"/>
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FBE27A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#23232B"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7A7A85"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <!-- 설정 항목이 화면 높이를 넘으면 스크롤 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="{loc:Text Language}" Style="{StaticResource SectionTitle}"/>
        <ComboBox x:Name="LanguageBox" SelectedValuePath="Tag" FontSize="14" Padding="8,6" Margin="0,6,0,6">
            <ComboBoxItem Content="한국어" Tag="ko"/>
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
            <ComboBoxItem Content="日本語" Tag="ja"/>
        </ComboBox>
        <TextBlock Text="{loc:Text LanguageHint}" Style="{StaticResource Hint}" Margin="0,0,0,20"/>
        <TextBlock x:Name="Intro" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                   Foreground="#4A4A55" Margin="0,0,0,16"/>

        <!-- 메모 저장 폴더 -->
        <TextBlock Text="{loc:Text StorageFolder}" Style="{StaticResource SectionTitle}"/>
        <Grid Margin="0,6,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="8" Background="#ECEAE4" Padding="10,7">
                <TextBox x:Name="PathBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         Padding="0" FontSize="13" Foreground="#23232B"/>
            </Border>
            <Button Grid.Column="1" Content="{loc:Text Browse}" Style="{StaticResource SoftButton}" Click="Browse_Click"/>
        </Grid>
        <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,0,0,20"/>

        <!-- 덱 표시 모니터: 설정 모드에서만 표시 -->
        <StackPanel x:Name="MonitorSection" Margin="0,0,0,20">
            <TextBlock Text="{loc:Text DockMonitor}" Style="{StaticResource SectionTitle}"/>
            <ComboBox x:Name="MonitorBox" Margin="0,8,0,6" FontSize="13" Padding="8,6"
                      DisplayMemberPath="DisplayName"/>
            <TextBlock Text="{loc:Text DockMonitorHint}"
                       Style="{StaticResource Hint}"/>
        </StackPanel>

        <!-- 덱 동작: 설정 모드에서만 표시 -->
        <StackPanel x:Name="DeckSection" Margin="0,0,0,20">
            <TextBlock Text="{loc:Text Deck}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Text VisibleCount}" FontSize="13" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                    <ComboBox x:Name="MaxNotesBox" Width="90" FontSize="13" Padding="8,4"/>
                    <TextBlock Text="{loc:Text NotesUnit}" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Text VerticalPosition}" FontSize="13" VerticalAlignment="Center"/>
                <Slider x:Name="CenterPercentSlider" Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="90"
                        TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,6"/>
                <TextBlock Grid.Row="1" Grid.Column="2" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{loc:Text PositionValue, Value={Binding Value, ElementName=CenterPercentSlider}}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Text CollapseDelay}" FontSize="13" VerticalAlignment="Center"/>
                <Slider x:Name="DelaySlider" Grid.Row="2" Grid.Column="1" Minimum="100" Maximum="2000"
                        TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,6"/>
                <TextBlock Grid.Row="2" Grid.Column="2" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding Value, ElementName=DelaySlider, StringFormat='{}{0:0} ms'}"/>
            </Grid>
            <TextBlock Text="{loc:Text DeckLimitHint}"
                       Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            <CheckBox x:Name="HideOnFullscreenBox" Content="{loc:Text HideFullscreen}"
                      FontSize="13" Foreground="#23232B" Margin="0,10,0,0"/>
            <CheckBox x:Name="HotkeysBox" Content="{loc:Text UseHotkeys}"
                      FontSize="13" Foreground="#23232B" Margin="0,8,0,0"/>
            <TextBlock x:Name="HotkeysHint" Style="{StaticResource Hint}" Margin="22,2,0,0"/>
            <CheckBox x:Name="UpdateCheckBox" Content="{loc:Text AutoUpdate}"
                      FontSize="13" Foreground="#23232B" Margin="0,8,0,0"/>
            <TextBlock Text="{loc:Text AutoUpdateHint}"
                       Style="{StaticResource Hint}" Margin="22,2,0,0"/>
        </StackPanel>

        <!-- 글꼴: 설정 모드에서만 표시 -->
        <StackPanel x:Name="FontSection" Margin="0,0,0,20">
            <TextBlock Text="{loc:Text Font}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Text Font}" FontSize="13" VerticalAlignment="Center"/>
                <ComboBox x:Name="FontBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" FontSize="13" Padding="8,4" Margin="0,2"
                          MaxDropDownHeight="360" SelectionChanged="FontBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontFamily="{Binding Family}" FontSize="14"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Text BodySize}" FontSize="13" VerticalAlignment="Center"/>
                <Slider x:Name="FontSizeSlider" Grid.Row="1" Grid.Column="1" Minimum="10" Maximum="24"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,6"
                        ValueChanged="FontSizeSlider_ValueChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                           Text="{Binding Value, ElementName=FontSizeSlider, StringFormat='{}{0:0} pt'}"/>
            </Grid>
            <Border CornerRadius="10" Background="#FBE27A" Padding="14,10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="FontPreviewTitle" Text="{loc:Text PreviewTitle}" FontWeight="SemiBold" Foreground="#23232B"/>
                    <TextBlock x:Name="FontPreviewBody" Text="{loc:Text PreviewBody}" Foreground="#2E2E36"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{loc:Text FontHint}"
                       Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 시작 옵션: 설정 모드에서만 표시 -->
        <StackPanel x:Name="StartupSection" Margin="0,0,0,20">
            <TextBlock Text="{loc:Text Startup}" Style="{StaticResource SectionTitle}"/>
            <CheckBox x:Name="AutoStartBox" Content="{loc:Text AutoStart}"
                      FontSize="13" Foreground="#23232B" Margin="0,8,0,6"
                      Checked="AutoStartBox_Changed" Unchecked="AutoStartBox_Changed"/>
            <TextBlock x:Name="AutoStartHint" Style="{StaticResource Hint}"/>
        </StackPanel>

        <Grid>
            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{loc:Text Cancel}" Style="{StaticResource SoftButton}" IsCancel="True"/>
                <Button Content="{loc:Text OK}" Style="{StaticResource SoftButton}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>

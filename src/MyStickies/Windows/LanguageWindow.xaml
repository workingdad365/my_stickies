<Window x:Class="MyStickies.Windows.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Stickies · Language / 언어"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#F7F6F2" FontFamily="Malgun Gothic"
        Icon="pack://application:,,,/MyStickies;component/Assets/app.ico">
    <StackPanel Margin="28">
        <TextBlock Text="언어를 선택하세요" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Choose your language" FontSize="16" Margin="0,4,0,20"/>
        <ComboBox x:Name="LanguageBox" FontSize="16" Padding="10,8" SelectedValuePath="Tag">
            <ComboBoxItem Content="한국어" Tag="ko"/>
            <ComboBoxItem Content="English" Tag="en"/>
        </ComboBox>
        <TextBlock Text="설정에서 나중에 변경할 수 있습니다.&#xA;You can change this later in Settings."
                   TextWrapping="Wrap" Foreground="#7A7A85" Margin="0,12,0,20"/>
        <Button Content="계속 / Continue" Padding="18,8" HorizontalAlignment="Right"
                IsDefault="True" Click="Continue_Click"/>
    </StackPanel>
</Window>
